<Window x:Class="RobloxPlayerNotifierApp.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobloxPlayerNotifierApp"
        mc:Ignorable="d" Background="#F4F5F7"
        Title="Roblox Player Notifier" Height="450" Width="600"
        MinHeight="400" MinWidth="525"
        Loaded="MainView_OnLoaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#00A2FF" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="Roblox Player Notifier" Foreground="White" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBlock Text="Live Status Monitor" Foreground="#D0EFFF" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Add Player & Settings Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Input Box -->
                <TextBox Grid.Column="0" Text="{Binding NewPlayerName, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="6,4" FontSize="13" VerticalAlignment="Center" 
                         ToolTip="Enter Roblox Username"/>

                <!-- Add Button -->
                <Button Grid.Column="1" Command="{Binding AddPlayerCommand}" 
                        Content="+ Add Player" Margin="6,0,0,0" Padding="12,5" 
                        Background="#00A2FF" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>

                <!-- Interval Settings -->
                <TextBlock Grid.Column="3" Text="Interval (s):" VerticalAlignment="Center" FontSize="12" Foreground="#555"/>
                <TextBox Grid.Column="4" Text="{Binding CheckIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="6,0,0,0" Padding="4,4" FontSize="13" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                <Button Grid.Column="5" Command="{Binding RefreshStatusCommand}" 
                        Content="Refresh" Margin="6,0,0,0" Padding="8,5" 
                        Background="#E0E0E0" Foreground="#333" FontWeight="SemiBold" Cursor="Hand" ToolTip="Check status now"/>
            </Grid>
        </Border>

        <!-- Player List -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="5">
            <ListView x:Name="PlayerStatusListView"
                      ItemsSource="{Binding PlayerStatusList}"
                      BorderThickness="0"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="6,8">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45*" />
                                    <ColumnDefinition Width="25*" />
                                    <ColumnDefinition Width="15*" />
                                    <ColumnDefinition Width="15*" />
                                </Grid.ColumnDefinitions>

                                <!-- Player Username -->
                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="#222"/>

                                <!-- Status Badge -->
                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10" Padding="8,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Playing">
                                                    <Setter Property="Background" Value="#E6F9ED"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Online">
                                                    <Setter Property="Background" Value="#E6F4FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                    <Setter Property="Background" Value="#F2F2F2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Playing">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Online">
                                                        <Setter Property="Foreground" Value="#00A2FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Join Profile Button -->
                                <Button Grid.Column="2" 
                                        Content="Join" 
                                        Command="{Binding ElementName=PlayerStatusListView, Path=DataContext.ViewProfileCommand}"
                                        CommandParameter="{Binding .}"
                                        Visibility="{Binding ProfileButtonVisibility}" 
                                        Background="#10B981"
                                        Foreground="White" 
                                        FontWeight="Bold" Padding="8,3" Margin="0,0,5,0" Cursor="Hand"/>

                                <!-- Remove Button -->
                                <Button Grid.Column="3" 
                                        Content="Delete" 
                                        Command="{Binding ElementName=PlayerStatusListView, Path=DataContext.RemovePlayerCommand}"
                                        CommandParameter="{Binding .}"
                                        Background="#EF4444"
                                        Foreground="White" 
                                        FontWeight="SemiBold" Padding="8,3" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Footer Info -->
        <TextBlock Grid.Row="3" Text="Minimize or close to run in background system tray." Margin="0,6,0,0" FontSize="11" Foreground="#777" HorizontalAlignment="Center"/>
    </Grid>
</Window>
